PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiresense?schema=public
JWT_SECRET=hiresense-super-secret-jwt-key-minimum-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
BCRYPT_ROUNDS=10
