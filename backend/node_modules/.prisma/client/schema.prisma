// HireSense - Prisma Schema
// PostgreSQL database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ENUMS =====

enum UserRole {
  ADMIN
  RECRUITER
  HIRING_MANAGER
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
  ARCHIVED
}

enum CandidateStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum MatchCategory {
  EXCELLENT
  STRONG
  GOOD
  MODERATE
  WEAK
}

enum NotificationType {
  RESUME_UPLOADED
  SCREENING_COMPLETE
  CANDIDATE_SHORTLISTED
  CANDIDATE_REJECTED
  SCORE_UPDATED
  INTERVIEW_GENERATED
  PIPELINE_CHANGED
  JOB_CREATED
  SYSTEM
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGGED_IN
  USER_LOGGED_OUT
  JOB_CREATED
  JOB_UPDATED
  JOB_DELETED
  RESUME_UPLOADED
  CANDIDATE_SCREENED
  SCORE_GENERATED
  CANDIDATE_SHORTLISTED
  CANDIDATE_REJECTED
  PIPELINE_CHANGED
  INTERVIEW_GENERATED
  COPILOT_QUERIED
  EXPORT_GENERATED
  SETTINGS_UPDATED
}

// ===== MODELS =====

model Organization {
  id        String   @id @default(uuid())
  name      String
  domain    String?
  logoUrl   String?
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  jobs  Job[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole @default(RECRUITER)
  avatarUrl      String?
  isActive       Boolean  @default(true)
  onboardingDone Boolean  @default(false)
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization?    @relation(fields: [organizationId], references: [id])
  jobs          Job[]
  auditLogs     AuditLog[]
  notifications Notification[]
  savedSearches SavedSearch[]
  conversations AIConversation[]

  @@map("users")
}

model Job {
  id               String    @id @default(uuid())
  title            String
  department       String?
  location         String?
  locationType     String? // REMOTE, HYBRID, ONSITE
  employmentType   String? // FULL_TIME, PART_TIME, CONTRACT
  experienceMin    Int?
  experienceMax    Int?
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?   @default("USD")
  description      String    @db.Text
  requirements     String?   @db.Text
  responsibilities String?   @db.Text
  benefits         String?   @db.Text
  openings         Int       @default(1)
  status           JobStatus @default(DRAFT)
  aiAnalyzed       Boolean   @default(false)
  aiSummary        String?   @db.Text
  seniority        String?
  domain           String?
  organizationId   String
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  closedAt         DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  createdBy        User              @relation(fields: [createdById], references: [id])
  skills           JobSkill[]
  screeningResults ScreeningResult[]
  candidates       Candidate[]

  @@index([organizationId])
  @@index([status])
  @@index([createdById])
  @@map("jobs")
}

model JobSkill {
  id         String  @id @default(uuid())
  jobId      String
  skill      String
  isRequired Boolean @default(true)
  weight     Float   @default(1.0)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_skills")
}

model Resume {
  id           String    @id @default(uuid())
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  filePath     String
  rawText      String?   @db.Text
  status       String    @default("UPLOADED") // UPLOADED, PARSING, PARSED, FAILED
  errorMessage String?
  uploadedAt   DateTime  @default(now())
  parsedAt     DateTime?

  candidate Candidate?
  versions  ResumeVersion[]

  @@map("resumes")
}

model ResumeVersion {
  id        String   @id @default(uuid())
  resumeId  String
  version   Int      @default(1)
  rawText   String   @db.Text
  createdAt DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_versions")
}

model Candidate {
  id                String          @id @default(uuid())
  resumeId          String          @unique
  jobId             String
  firstName         String
  lastName          String
  email             String?
  phone             String?
  location          String?
  professionalTitle String?
  summary           String?         @db.Text
  yearsOfExperience Float?
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  status            CandidateStatus @default(APPLIED)
  overallScore      Float?
  matchCategory     MatchCategory?
  aiRecommendation  String?         @db.Text
  aiConfidence      Float?
  isShortlisted     Boolean         @default(false)
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  resume          Resume           @relation(fields: [resumeId], references: [id])
  job             Job              @relation(fields: [jobId], references: [id])
  skills          CandidateSkill[]
  tags            CandidateTag[]
  screeningResult ScreeningResult?
  interviews      Interview[]
  stageHistory    StageHistory[]
  experience      WorkExperience[]
  education       Education[]
  projects        Project[]
  certifications  Certification[]

  @@index([jobId])
  @@index([status])
  @@index([overallScore])
  @@map("candidates")
}

model CandidateSkill {
  id          String  @id @default(uuid())
  candidateId String
  skill       String
  proficiency String? // beginner, intermediate, advanced, expert
  yearsUsed   Float?
  isMatched   Boolean @default(false)
  isMissing   Boolean @default(false)
  isBonus     Boolean @default(false)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_skills")
}

model CandidateTag {
  id          String   @id @default(uuid())
  candidateId String
  tag         String
  color       String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, tag])
  @@map("candidate_tags")
}

model WorkExperience {
  id          String  @id @default(uuid())
  candidateId String
  company     String
  title       String
  location    String?
  startDate   String?
  endDate     String?
  isCurrent   Boolean @default(false)
  description String? @db.Text
  relevance   Float?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("work_experiences")
}

model Education {
  id          String  @id @default(uuid())
  candidateId String
  institution String
  degree      String
  field       String?
  startYear   Int?
  endYear     Int?
  gpa         Float?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("education")
}

model Project {
  id          String   @id @default(uuid())
  candidateId String
  name        String
  description String?  @db.Text
  techStack   String[]
  url         String?
  relevance   Float?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("projects")
}

model Certification {
  id           String  @id @default(uuid())
  candidateId  String
  name         String
  issuer       String?
  issuedDate   String?
  expiryDate   String?
  credentialId String?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("certifications")
}

model ScreeningResult {
  id                  String        @id @default(uuid())
  candidateId         String        @unique
  jobId               String
  overallScore        Float
  matchCategory       MatchCategory
  skillsScore         Float
  experienceScore     Float
  projectsScore       Float
  educationScore      Float
  certificationsScore Float
  domainScore         Float
  matchedSkills       String[]
  missingSkills       String[]
  bonusSkills         String[]
  strengths           String[]
  weaknesses          String[]
  explanation         String        @db.Text
  aiModel             String
  processingTimeMs    Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  candidate Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job               @relation(fields: [jobId], references: [id])
  factors   ScreeningFactor[]

  @@index([jobId])
  @@index([overallScore])
  @@map("screening_results")
}

model ScreeningFactor {
  id                String  @id @default(uuid())
  screeningResultId String
  factor            String
  score             Float
  weight            Float
  contribution      Float
  explanation       String?

  screeningResult ScreeningResult @relation(fields: [screeningResultId], references: [id], onDelete: Cascade)

  @@map("screening_factors")
}

model StageHistory {
  id          String           @id @default(uuid())
  candidateId String
  fromStatus  CandidateStatus?
  toStatus    CandidateStatus
  changedBy   String?
  notes       String?
  changedAt   DateTime         @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("stage_history")
}

model Interview {
  id             String    @id @default(uuid())
  candidateId    String
  jobId          String?
  title          String?
  totalQuestions Int       @default(0)
  generatedAt    DateTime  @default(now())
  exportedAt     DateTime?

  candidate Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  questions InterviewQuestion[]

  @@index([candidateId])
  @@map("interviews")
}

model InterviewQuestion {
  id                 String  @id @default(uuid())
  interviewId        String
  category           String // TECHNICAL, BEHAVIORAL, SITUATIONAL, RESUME_BASED, ROLE_SPECIFIC, FOLLOW_UP
  question           String  @db.Text
  whyItMatters       String? @db.Text
  expectedAnswer     String? @db.Text
  evaluationCriteria String? @db.Text
  difficulty         String? // EASY, MEDIUM, HARD
  orderIndex         Int

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@map("interview_questions")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  entityId   String?
  entityType String?
  metadata   Json?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  name      String
  filters   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_searches")
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@map("ai_conversations")
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String // USER, ASSISTANT
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  event      String
  entityId   String?
  entityType String?
  metadata   Json?
  userId     String?
  orgId      String?
  occurredAt DateTime @default(now())

  @@index([event])
  @@index([occurredAt])
  @@index([orgId])
  @@map("analytics_events")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityId   String?
  entityType String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
